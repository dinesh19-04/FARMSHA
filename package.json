{
  "name": "farmsha-platform",
  "version": "1.0.0",
  "description": "FARMSHA - Smart Machinery Sharing System for Farmers (Like Uber for Agricultural Equipment)",
  "scripts": {
    "dev:frontend": "cd frontend && npm run dev",
    "dev:backend": "cd backend && npm run dev",
    "start:frontend": "cd frontend && npm run dev",
    "start:backend": "cd backend && npm start",
    "build:frontend": "cd frontend && npm run build",
    "install:frontend": "cd frontend && npm install",
    "install:backend": "cd backend && npm install",
    "install:all": "npm run install:frontend && npm run install:backend"
  },
  "keywords": ["farmsha", "agriculture", "machinery", "sharing", "platform", "farmer", "tractor", "equipment"],
  "author": "",
  "license": "ISC",
  "workspaces": ["frontend", "backend"]
}
